{
  "name": "ai-compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint src worker tests",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src worker tests e2e scripts docs *.ts *.json *.jsonc index.html README.md",
    "format:check": "prettier --check src worker tests e2e scripts docs *.ts *.json *.jsonc index.html README.md"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "openai": "^7.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
